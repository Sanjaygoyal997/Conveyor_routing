<?xml version="1.0" encoding="utf-8"?>
<!-- IIS static site for the React build. Needs no extra IIS modules (no URL Rewrite: the app has no client-side routes). -->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <!-- index.html and config.js must never be cached: a new build or a changed apiBase shows up at once -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
  <!-- file names under assets/ contain a content hash, so they can be cached for a long time -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
